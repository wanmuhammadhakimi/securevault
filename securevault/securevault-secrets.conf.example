# Copy to /etc/apache2/conf-available/securevault-secrets.conf
#   sudo chown root:root ... && sudo chmod 600 ... && sudo a2enconf securevault-secrets
# Generate each key with:  openssl rand -hex 32   (BUZZER key: openssl rand -hex 16)
SetEnv AES_KEY_HEX        <64-hex-char key>
SetEnv FP_DEVICE_KEY      <random string shared with kiosk/kiosk_bridge.py>
SetEnv BUZZER_DEVICE_KEY  <random string shared with firmware/esp32_buzzer>
SetEnv EMERGENCY_KEY      <random string for api/emergency_unlock.php>
SetEnv SV_DB_USER         securevault
SetEnv SV_DB_PASS         <database password>
